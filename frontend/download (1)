import type {ReactNode} from 'react';
export function SectionHeading({eyebrow,title,description,action}:{eyebrow?:string;title:string;description?:string;action?:ReactNode}){return <div className="mb-7 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"><div>{eyebrow&&<div className="mb-2 text-xs font-extrabold uppercase tracking-[.22em] text-[#69926b]">{eyebrow}</div>}<h2 className="font-display text-2xl font-extrabold tracking-tight text-ink sm:text-3xl">{title}</h2>{description&&<p className="mt-2 max-w-xl text-sm text-muted sm:text-base">{description}</p>}</div>{action}</div>}
